# Copy this file to .env.local for local testing (never commit .env.local).
# In production, set these as Environment Variables in the Vercel dashboard:
# Project → Settings → Environment Variables.

# Bot token from @BotFather on Telegram, e.g. 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Your personal chat id, obtained via the getUpdates step in README.md
TELEGRAM_CHAT_ID=
